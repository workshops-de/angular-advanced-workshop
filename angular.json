{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bookmonkey-client": {
      "projectType": "application",
      "root": "projects/bookmonkey-client",
      "sourceRoot": "projects/bookmonkey-client/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/bookmonkey-client",
            "index": "projects/bookmonkey-client/src/index.html",
            "browser": "projects/bookmonkey-client/src/main.ts",
            "tsConfig": "projects/bookmonkey-client/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/bookmonkey-client/public"
              }
            ],
            "styles": ["projects/bookmonkey-client/src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "bookmonkey-client:build:production"
            },
            "development": {
              "buildTarget": "bookmonkey-client:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "bookmonkey-client:build"
          }
        },
        "test": {
          "builder": "@analogjs/vitest-angular:test"
        }
      }
    },
    "rating": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/rating",
      "sourceRoot": "projects/rating/src",
      "prefix": "rating",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "cacheExternalArtifacts": true,
            "tsConfig": "projects/rating/tsconfig.federation.json"
          },
          "configurations": {
            "production": {
              "target": "rating:esbuild:production"
            },
            "development": {
              "target": "rating:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "rating:serve-original:development",
            "tsConfig": "projects/rating/tsconfig.federation.json",
            "rebuildDelay": 500,
            "cacheExternalArtifacts": true,
            "dev": true,
            "devServer": true,
            "port": 0
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/rating/src/main.ts",
            "tsConfig": "projects/rating/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/rating/public"
              }
            ],
            "styles": ["projects/rating/src/styles.css"],
            "polyfills": ["es-module-shims"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "rating:esbuild:production"
            },
            "development": {
              "buildTarget": "rating:esbuild:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
