{
  "name": "bookmonkey-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bookmonkey-client/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/bookmonkey-client",
        "index": "apps/bookmonkey-client/src/index.html",
        "browser": "apps/bookmonkey-client/src/main.ts",
        "tsConfig": "apps/bookmonkey-client/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/bookmonkey-client/public"
          }
        ],
        "styles": ["apps/bookmonkey-client/src/styles.css"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "testing": {
          "aot": false,
          "optimization": false,
          "extractLicenses": false
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "bookmonkey-client:build:production"
        },
        "development": {
          "buildTarget": "bookmonkey-client:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "bookmonkey-client:build"
      }
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test"
    }
  }
}
