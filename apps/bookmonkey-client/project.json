{
  "name": "bookmonkey-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bookmonkey-client/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/bookmonkey-client/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "bookmonkey-client:esbuild:production"
        },
        "development": {
          "target": "bookmonkey-client:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "bookmonkey-client:serve-original:development",
        "tsConfig": "apps/bookmonkey-client/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "bookmonkey-client:build"
      }
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test"
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/bookmonkey-client",
        "index": "apps/bookmonkey-client/src/index.html",
        "browser": "apps/bookmonkey-client/src/main.ts",
        "tsConfig": "apps/bookmonkey-client/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/bookmonkey-client/public"
          }
        ],
        "styles": ["apps/bookmonkey-client/src/styles.css"],
        "scripts": [],
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "testing": {
          "aot": false,
          "optimization": false,
          "extractLicenses": false
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "bookmonkey-client:esbuild:production"
        },
        "development": {
          "buildTarget": "bookmonkey-client:esbuild:development"
        }
      },
      "options": {
        "port": 4200
      }
    }
  },
  "tags": ["type:app"]
}
